Output docs/assets/makevn-verify-docker.gif

Set Shell "zsh"
Set FontSize 22
Set Width 1200
Set Height 720
Set TypingSpeed 30ms
Set Framerate 12
Set PlaybackSpeed 1.4
Set Theme { "name": "makevn", "black": "#17212b", "red": "#ef4444", "green": "#22c55e", "yellow": "#f59e0b", "blue": "#38bdf8", "magenta": "#c084fc", "cyan": "#2dd4bf", "white": "#e5e7eb", "brightBlack": "#64748b", "brightRed": "#f87171", "brightGreen": "#4ade80", "brightYellow": "#fbbf24", "brightBlue": "#7dd3fc", "brightMagenta": "#d8b4fe", "brightCyan": "#5eead4", "brightWhite": "#f8fafc", "background": "#0f172a", "foreground": "#e5e7eb", "selection": "#334155", "cursor": "#f8fafc" }

Hide
Type "docs/demo/setup-docker-demo-repo.sh /tmp/makevn-docker-demo >/dev/null"
Enter
Type "cd /tmp/makevn-docker-demo"
Enter
Type "makevn init >/dev/null"
Enter
Type "clear"
Enter
Show
Type "makevn docker-up docker-ps-required verify"
Enter
Sleep 32s
