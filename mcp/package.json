{
  "name": "@antonillos/makevn-mcp",
  "version": "0.1.0",
  "description": "MCP server for makevn - Terminal-first Java Maven workflows",
  "license": "MIT",
  "type": "module",
  "bin": {
    "makevn-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "bash bundle.sh",
    "watch": "tsc --watch",
    "prepare": "npm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "makevn",
    "maven",
    "java"
  ]
}
